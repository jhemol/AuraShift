# Supabase: Project Settings > Database > Connect > Session pooler.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Require TLS and verify the database server certificate.
PGSSLMODE=require
API_PORT=5174
