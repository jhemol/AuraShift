# Supabase: Project Settings > Database > Connect > Session pooler.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Supabase Project Settings > API: these are public project settings, not secret keys.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Vite exposes only these non-secret project settings to the web client.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Require TLS and verify the database server certificate.
PGSSLMODE=require
# Supabase Database Settings > SSL Configuration: path to the downloaded CA certificate.
PGSSLROOTCERT=.supabase/prod-ca-2021.crt
# Optional UUID of the first Supabase account that should receive the legacy single-wardrobe data.
WARDROBE_LEGACY_OWNER_ID=
API_PORT=5174
